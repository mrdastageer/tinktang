GOOGLE_API_KEY=your-google-api-key
MODEL_NAME=gemini-3-flash-preview

NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b

OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_MODEL=ThinkTank

MODEL_API_KEY=your-model-api-key
META_MUSE_MODEL=muse-spark-1.1

FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIRESTORE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-admin-service-account.json
TEMPERATURE=0.7
MAX_TOKENS=2048
CREWAI_TRACING_ENABLED=true
